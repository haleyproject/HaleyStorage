<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <HaleyProject Condition="'$(HaleyProject)' == ''">$(MSBuildProjectDirectory)\..\..</HaleyProject>
  </PropertyGroup>
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Source.Props" />
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Version.Props" />
  <Import Project="$(HaleyProject)\HaleyProject\Haley.Paths.Props" />
  <Import Project="Database\Database.Source.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Haley</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>TheHaleyProject</Authors>
    <Company>TheHaleyProject</Company>
    <AssemblyName>Haley.Storage</AssemblyName>
    <Copyright>Haley 2025</Copyright>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\HaleyProject\HaleyProject.snk</AssemblyOriginatorKeyFile>
    <PackageIcon>Haley.png</PackageIcon>
    <Version>$(HaleyStorageVersion)</Version>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageProjectUrl>https://github.com/haleyproject/HaleyStorage</PackageProjectUrl>
    <RepositoryUrl>https://github.com/haleyproject/HaleyStorage</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>A storage service provider</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\HaleyProject\Haley.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Scripts\" />
  </ItemGroup>

  <!-- Standalone-build fallback: if the solution-level import did not define $(HaleyAbstractions)
       but the sibling project folder exists on disk, resolve via relative path so developer-machine
       builds find the local source instead of the (potentially stale) NuGet package. -->
  <PropertyGroup>
    <HaleyAbstractions Condition="'$(HaleyAbstractions)' == '' AND Exists('..\..\HaleyAbstractions\HaleyAbstractions\HaleyAbstractions.csproj')">..\..\HaleyAbstractions\HaleyAbstractions</HaleyAbstractions>
  </PropertyGroup>

  <!--<Choose>
    <When Condition="Exists('$(HaleyAbstractionsProj)')">
      <ItemGroup>
        <ProjectReference Include="$(HaleyAbstractionsProj)">
          <Name>HaleyAbstractions</Name>
        </ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Haley.Abstractions" Version="$(HaleyAbstractionsVersion)" />
      </ItemGroup>
    </Otherwise>
  </Choose>-->
  <Choose>
    <When Condition="Exists('$(HaleyHelpersProj)')">
      <ItemGroup>
        <ProjectReference Include="$(HaleyHelpersProj)">
          <Name>HaleyHelpers</Name>
        </ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Haley.Helpers" Version="$(HaleyHelpersVersion)" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <Choose>
    <When Condition="Exists('$(HaleyHelpersDBProj)')">
      <ItemGroup>
        <ProjectReference Include="$(HaleyHelpersDBProj)">
          <Name>HaleyHelpersDB</Name>
        </ProjectReference>
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageReference Include="Haley.Helpers.DB" Version="$(HaleyHelpersDBVersion)" />
      </ItemGroup>
    </Otherwise>
  </Choose>

</Project>
